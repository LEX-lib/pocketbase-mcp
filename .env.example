# PocketBase instance URL (required)
POCKETBASE_URL=http://127.0.0.1:8090

# Superuser credentials used for auto-login (required)
POCKETBASE_SUPERUSER_EMAIL=admin@test.local
POCKETBASE_SUPERUSER_PASSWORD=SuperSecret123!

# Optional: per-request timeout in milliseconds (default 15000)
# POCKETBASE_API_TIMEOUT_MS=15000
