{
  "name": "pocketbase-mcp",
  "version": "0.1.0",
  "description": "MCP server for managing a PocketBase instance from chat",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pocketbase-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test:e2e": "tsx test/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "pocketbase",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/inspector": "^0.18.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
